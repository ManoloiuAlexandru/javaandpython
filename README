class book:
    title,author,year,pages,genre,price,soldbooks

class card:
     card number,name, exp date and cvv debit/credit
     if credit: limit, balance

class user:
    nume, parola, books, favoritebooks, cards, bankaccounts

class transaction:
    ammount, type and date

class BankAccount:
    ammount, bank linked to card if card is debit just take from ammont
    if card is credit ammount can get negativ but not more then a limit 

